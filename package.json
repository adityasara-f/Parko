{
  "name": "parko-root",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "server": "npm --prefix server run dev",
    "client": "npm --prefix client run dev",
    "build:server": "npm --prefix server run build",
    "build:client": "npm --prefix client run build",
    "build": "npm run build:server && npm run build:client",
    "start": "npm --prefix server run start",
    "db:init": "node server/apply_seed.js schema",
    "db:seed": "node server/apply_seed.js seed",
    "db:views": "node server/apply_seed.js views",
    "db:diagnostics": "node server/apply_seed.js diagnostics",
    "test:api": "node server/test_all_workflows.js",
    "test": "npm run build && npm --prefix server run test"
  }
}
