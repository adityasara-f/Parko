PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Server-only MySQL connection. Use DB_SSL=true for hosted databases.
DB_HOST=your_mysql_host
DB_PORT=3306
DB_USER=your_mysql_user
DB_PASSWORD=replace_with_your_mysql_password
DB_NAME=parko_db
DB_SSL=false
DB_SSL_CA=

# Server-only signing secret, at least 32 bytes. Configure ADMIN_USER_ID only
# after creating the administrator account through a trusted provisioning path.
JWT_SECRET=replace_with_a_random_secret_of_at_least_32_bytes
ADMIN_USER_ID=
