{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "services": {
        "client": {
            "root": "client/"
        },
        "server": {
            "root": "server/",
            "framework": "express",
            "entrypoint": "src/index.ts",
            "installCommand": "npm install"
        }
    },
    "rewrites": [
        {
            "source": "/api",
            "destination": {
                "service": "server"
            }
        },
        {
            "source": "/api/(.*)",
            "destination": {
                "service": "server"
            }
        },
        {
            "source": "/(.*)",
            "destination": {
                "service": "client"
            }
        }
    ]
}